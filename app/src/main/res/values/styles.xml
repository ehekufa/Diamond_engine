<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Diamond" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/viewport_background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bar_background</item>
        <item name="android:navigationBarColor">@color/bar_background</item>
    </style>

    <!-- Compact toolbar button: 48dp touch target, no elevation, no ripple
         animation (the frame budget belongs to the render thread). -->
    <style name="Widget.Diamond.ToolButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/bar_foreground</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
