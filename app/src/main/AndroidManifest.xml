<?xml version="1.0" encoding="utf-8"?>
<!--
  Diamond Engine — application manifest.

  Notes
    * No INTERNET permission: the editor is fully offline. Scenes, models and
      scripts live in the app's own storage.
    * hardwareAccelerated is off for the editor window because the viewport is
      an ANativeWindow fed by the engine's own render thread; letting the
      framework also composite it wastes a full-screen copy per frame.
    * largeHeap is deliberately NOT set: the allocator budget in the engine is
      tuned for 1 GB phones and a large heap only hides leaks.
    * android:extractNativeLibs="false" keeps libengine.so mapped straight from
      the APK (16 KiB page aligned), which halves install size.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="36" />

    <!-- OpenGL ES 3.0 is what the editor renders with; 2.0 is the fallback. -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <!-- Vulkan is optional: devices without it simply do not offer the mode. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false" />

    <!-- Touch is the only input. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:extractNativeLibs="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Diamond">

        <activity
            android:name=".ui.EditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- .diamond projects opened from a file manager. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-diamond-project" />
            </intent-filter>
        </activity>

    </application>

</manifest>
